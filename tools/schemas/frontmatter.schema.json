{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frontmatter.schema.json",
  "title": "Document Frontmatter Schema",
  "description": "JSON Schema for validating YAML frontmatter metadata in Sports Experience Guidelines documents",
  "type": "object",
  "required": [
    "title",
    "subdomain",
    "experience-area",
    "document-type",
    "owner",
    "last-updated",
    "status",
    "tags",
    "summary"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "description": "Document title, max 100 characters"
    },
    "subdomain": {
      "type": "string",
      "enum": [
        "discovery",
        "transactional",
        "post-bet",
        "cross-cutting-areas"
      ],
      "description": "The subdomain this document belongs to"
    },
    "experience-area": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Experience area name in lowercase-kebab-case"
    },
    "document-type": {
      "type": "string",
      "enum": [
        "overview",
        "principles",
        "patterns",
        "research",
        "decisions",
        "guidelines",
        "examples"
      ],
      "description": "The type of document from the closed enumerated list"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Lead Designer name responsible for this document"
    },
    "last-updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date format (YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-review",
        "published",
        "deprecated"
      ],
      "description": "Document lifecycle status"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "maxItems": 15,
      "description": "Array of 1-15 lowercase-kebab-case tags"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Machine-readable summary, max 200 words. Word count validated externally."
    },
    "scope-references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subdomain",
          "influence"
        ],
        "properties": {
          "subdomain": {
            "type": "string",
            "enum": [
              "discovery",
              "transactional",
              "post-bet",
              "cross-cutting-areas"
            ]
          },
          "influence": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "informational"
            ]
          }
        },
        "additionalProperties": false
      },
      "description": "For cross-cutting documents: lists each affected subdomain and influence level"
    },
    "relationships": {
      "type": "object",
      "properties": {
        "depends-on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts-with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related-to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "Typed relationship references to other document paths"
    },
    "maturity": {
      "type": "string",
      "enum": [
        "not-started",
        "in-progress",
        "documented",
        "validated"
      ],
      "description": "Maturity indicator for the experience area"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "author",
          "summary"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "author": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "description": "Change summary, max 150 words. Word count validated externally."
          }
        },
        "additionalProperties": false
      },
      "description": "Version history tracking date, author, and summary of changes"
    }
  },
  "additionalProperties": false
}
